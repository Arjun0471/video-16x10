{
  "manifest_version": 3,
  "name": "Smart 16:10 for YouTube",
  "version": "3.6.0",
  "description": "Live content-aware pixel removal so 16:9 videos fill 16:10 screens with no bars or cropping.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
